# ==========================================================================
# PRODUCTION .env NAMUNASI — serverdagi backend/.env shu ko'rinishda bo'lishi
# SHART. Lokal dev uchun emas! Serverga nusxalab, qiymatlarni to'ldiring.
# ==========================================================================

# MUHIM: 'prod' bo'lmasa dev.py yuklanadi va CORS faqat localhost'ga ruxsat
# beradi — https://avtoyon.uz dan kelgan so'rovlar CORS bilan bloklanadi.
ENVIRONMENT=prod

# Yangi kalit yaratish: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DIQQAT: SECRET_KEY JWT imzo kaliti hamdir — o'zgartirilsa barcha
# foydalanuvchilar qayta login qilishi kerak bo'ladi.
SECRET_KEY=BU_YERGA_YANGI_KUCHLI_KALIT

DEBUG=False

# API qaysi domenlarda xizmat qiladi (vergul bilan)
ALLOWED_HOSTS=api.avtoyon.uz

# Frontend originlari — CORS oq ro'yxati (vergul bilan, protokol bilan yoziladi).
# Shu ro'yxatda bo'lmagan origin'dan kelgan so'rovga Access-Control-Allow-Origin
# qaytarilmaydi va brauzer javobni bloklaydi.
CORS_ALLOWED_ORIGINS=https://avtoyon.uz,https://www.avtoyon.uz
# Ko'rsatilmasa CORS_ALLOWED_ORIGINS'dan olinadi
# CSRF_TRUSTED_ORIGINS=https://avtoyon.uz,https://www.avtoyon.uz

FRONTEND_URL=https://avtoyon.uz

## Database
DB_NAME=avtoyon_db
DB_USER=avtoyon_user
DB_PASSWORD=KUCHLI_PAROL
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=app_parol
DEFAULT_FROM_EMAIL=example@gmail.com
